import requests
import psycopg2
import os
from dotenv import load_dotenv

load_dotenv()

def collecter_et_charger_lycees(db):
    import requests

url = "https://data.education.gouv.fr/api/explore/v2.1/catalog/datasets/fr-en-annuaire-education/records"

all_lycees = []
offset = 0
limit = 100

while True:
    params = {
        "limit": limit,
        "offset": offset,
        "where": 'type_etablissement LIKE "LYCEE%"'
    }

    response = requests.get(url, params=params).json()
    lycee = response.get("results", [])

    if not lycee:
        break  # plus rien à récupérer

    all_lycees.extend(lycee)
    offset += limit

print("Nombre total de lycées récupérés :", len(all_lycees))

# Affichage des 5 premiers lycées
for l in all_lycees[:5]:
    uai = l.get("identifiant_de_l_etablissement")
    nom = l.get("nom_etablissement")
    adresse = " ".join([
        str(l.get("adresse_1") or ""),
        str(l.get("adresse_2") or ""),
        str(l.get("adresse_3") or "")
    ]).strip()
    lat = l.get("latitude")
    lon = l.get("longitude")
    code_insee = l.get("code_commune")

    print(f"\nUAI : {uai}")
    print(f"Nom : {nom}")
    print(f"Adresse : {adresse}")
    print(f"Latitude : {lat} | Longitude : {lon}")
    print(f"Code INSEE : {code_insee}")

    query = """
            INSERT INTO lycee (uai, nom, adresse, code_insee)
            VALUES (%s, %s, %s, %s)
            ON CONFLICT (uai) DO NOTHING;
        """
        
    try:
            db.execute(query, (uai, nom, adresse, code_insee))
    except Exception as e:
            print(f"Erreur insertion {uai}: {e}")

# Exemple d'appel
if __name__ == "__main__":
    from database import Database
    db = Database()
    collecter_et_charger_lycees(db)
    print("✅ Lycées traités.")